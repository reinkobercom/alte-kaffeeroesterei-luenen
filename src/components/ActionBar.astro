---
// Mobile Aktionsleiste: die beiden Haupt-Aktionen der Startseite immer griffbereit.
// Nur auf schmalen Bildschirmen sichtbar.
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<div class="actionbar" role="region" aria-label="Schnellzugriff">
  <a class="actionbar__item" href={site.phone.href}>
    <Icon name="phone" />
    <span>Reservierung anfragen</span>
  </a>
  <a class="actionbar__item" href={site.menuPdf} target="_blank" rel="noopener">
    <Icon name="menu-card" />
    <span>Speisekarte ansehen</span>
  </a>
</div>

<style>
  .actionbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--c-roast);
    padding-bottom: env(safe-area-inset-bottom);
    box-shadow: 0 -4px 18px rgba(43, 26, 14, 0.18);
  }
  .actionbar__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 3.5rem;
    padding: 0.5rem;
    color: var(--c-white);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
  }
  .actionbar__item + .actionbar__item {
    border-left: 1px solid rgba(255, 255, 255, 0.18);
  }
  .actionbar__item:hover {
    color: var(--c-white);
    background: var(--c-espresso);
  }
  .actionbar svg {
    width: 1.2rem;
    height: 1.2rem;
  }
  @media (min-width: 48em) {
    .actionbar {
      display: none;
    }
  }
</style>

<style is:global>
  @media (max-width: 47.99em) {
    :root {
      --actionbar-h: calc(3.5rem + env(safe-area-inset-bottom));
    }
  }
</style>
