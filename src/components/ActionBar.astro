---
// Mobile Aktionsleiste: die beiden Haupt-Aktionen immer griffbereit.
// Nur auf schmalen Bildschirmen. Erscheint erst nach dem Runterscrollen
// (sobald die Buttons im Kopfbereich aus dem Bild sind bzw. nach 320 px).
import { site } from '../data/site';
import Icon from './Icon.astro';
---

<div class="actionbar" role="region" aria-label="Schnellzugriff" data-actionbar>
  <a class="actionbar__item" href={site.phone.href}>
    <Icon name="phone" />
    <span>Reservierung anfragen</span>
  </a>
  <a class="actionbar__item" href={site.menuPdf} target="_blank" rel="noopener">
    <Icon name="menu-card" />
    <span>Speisekarte ansehen</span>
  </a>
</div>

<script>
  const bar = document.querySelector<HTMLElement>('[data-actionbar]');
  if (bar) {
    const heroButtons = document.querySelector('.hero .btn-row');
    const show = (visible: boolean) => {
      bar.classList.toggle('is-visible', visible);
      bar.toggleAttribute('inert', !visible);
    };
    show(false);
    if (heroButtons && 'IntersectionObserver' in window) {
      // sichtbar, sobald die Hero-Buttons nach oben aus dem Bild gescrollt sind
      new IntersectionObserver(([entry]) => {
        show(!entry.isIntersecting && entry.boundingClientRect.top < 0);
      }).observe(heroButtons);
    } else {
      const onScroll = () => show(window.scrollY > 320);
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  }
</script>

<style>
  .actionbar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: var(--c-roast);
    padding-bottom: env(safe-area-inset-bottom);
    box-shadow: 0 -4px 18px rgba(43, 26, 14, 0.18);
    transform: translateY(110%);
    transition: transform 0.25s ease;
  }
  .actionbar.is-visible {
    transform: translateY(0);
  }
  .actionbar__item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 0;
    min-height: 3.25rem;
    padding: 0.5rem 0.4rem;
    color: var(--c-white);
    font-size: clamp(0.8125rem, 3.5vw, 0.9375rem);
    font-weight: 500;
    line-height: 1.2;
    white-space: nowrap;
    text-decoration: none;
  }
  .actionbar__item + .actionbar__item {
    border-left: 1px solid rgba(255, 255, 255, 0.18);
  }
  .actionbar__item:hover {
    color: var(--c-white);
    background: var(--c-espresso);
  }
  .actionbar svg {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
  }
  @media (min-width: 48em) {
    .actionbar {
      display: none;
    }
  }
</style>

<style is:global>
  @media (max-width: 47.99em) {
    :root {
      --actionbar-h: calc(3.25rem + env(safe-area-inset-bottom));
    }
  }
</style>
