---
// Bildergalerie ohne Lightbox. Mobil horizontal wischbar, ab Tablet als Raster.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

type Img = { src: ImageMetadata; alt: string };
interface Props {
  images: Img[];
  label: string;
  square?: boolean;
}
const { images, label, square = false } = Astro.props;
---

<ul class:list={['gallery', square && 'gallery--square', images.length % 3 === 1 && 'gallery--lead']} aria-label={label}>
  {
    images.map((img) => (
      <li>
        <Image src={img.src} alt={img.alt} widths={[400, 700, 1000]} sizes="(min-width: 48em) 33vw, 78vw" />
      </li>
    ))
  }
</ul>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter) 0.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 78%;
    gap: 0.6rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
  }
  .gallery li {
    scroll-snap-align: start;
  }
  .gallery img {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .gallery--square img {
    aspect-ratio: 1;
  }
  @media (min-width: 48em) {
    .gallery {
      max-width: calc(var(--wrap) + 2 * var(--gutter));
      margin-inline: auto;
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(3, 1fr);
      overflow: visible;
      padding-bottom: 0;
    }
    .gallery img {
      aspect-ratio: 4 / 3;
    }
    .gallery--square img {
      aspect-ratio: 1;
    }
    /* 4, 7, 10 … Bilder: vier Spalten, das erste Bild doppelt breit -> keine Lücke */
    .gallery--lead {
      grid-template-columns: repeat(4, 1fr);
    }
    .gallery--lead li:first-child {
      grid-column: span 2;
    }
    .gallery--lead li:first-child img {
      aspect-ratio: auto;
    }
  }
</style>
