---
import { Image } from 'astro:assets';
import logo from '../assets/images/logo.png';
import { mainNav, site } from '../data/site';
import Icon from './Icon.astro';

const current = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---

<header class="site-header" data-header>
  <div class="wrap site-header__inner">
    <a class="site-header__logo" href="/" aria-label={`${site.name} – Startseite`}>
      <Image src={logo} alt="" widths={[270, 540]} sizes="13.5rem" loading="eager" />
    </a>

    <nav class="site-nav" aria-label="Hauptnavigation">
      <button
        class="site-nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="site-nav-list"
        data-nav-toggle
      >
        <span class="site-nav__bars" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="site-nav__toggle-label">Menü</span>
      </button>

      <div class="site-nav__panel" id="site-nav-list" data-nav-panel>
        <ul class="site-nav__list">
          {
            mainNav.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="btn btn--primary site-nav__call" href={site.phone.href}>
          <Icon name="phone" />
          {site.phone.display}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-nav-panel]');
  if (toggle && panel) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('is-open', open);
      document.documentElement.classList.toggle('nav-open', open);
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
    window.matchMedia('(min-width: 75em)').addEventListener('change', (e) => e.matches && setOpen(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.97);
    border-bottom: 1px solid var(--c-line);
  }
  @supports (backdrop-filter: blur(8px)) {
    .site-header {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(8px);
    }
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-height: var(--header-h);
  }
  .site-header__logo {
    display: block;
    width: min(13.5rem, 58vw);
    flex: none;
  }
  .site-header__logo img {
    width: 100%;
    height: auto;
  }

  .site-nav__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.85rem;
    border: 1.5px solid var(--c-line);
    border-radius: 999px;
    background: var(--c-white);
    color: var(--c-roast);
    font: 500 0.9375rem var(--f-text);
    cursor: pointer;
  }
  .site-nav__bars {
    display: grid;
    gap: 4px;
    width: 18px;
  }
  .site-nav__bars span {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .site-nav__toggle[aria-expanded='true'] .site-nav__bars span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .site-nav__toggle[aria-expanded='true'] .site-nav__bars span:nth-child(2) {
    opacity: 0;
  }
  .site-nav__toggle[aria-expanded='true'] .site-nav__bars span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobil: Panel unter dem Header */
  .site-nav__panel {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: calc(100dvh - var(--header-h));
    border-top: 1px solid var(--c-line);
    background: var(--c-white);
    padding: var(--space-3) var(--gutter) var(--space-4);
    overflow-y: auto;
  }
  .site-nav__panel.is-open {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .site-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav__list a {
    display: block;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--c-line);
    font-family: var(--f-head);
    font-size: 1.375rem;
    color: var(--c-roast);
    text-decoration: none;
  }
  .site-nav__list a[aria-current='page'] {
    color: var(--c-caramel-deep);
  }
  .site-nav__call {
    align-self: flex-start;
  }

  @media (min-width: 75em) {
    .site-nav__toggle {
      display: none;
    }
    .site-nav__panel,
    .site-nav__panel.is-open {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: var(--space-3);
      position: static;
      height: auto;
      border-top: 0;
      padding: 0;
      background: none;
      overflow: visible;
    }
    .site-nav__list {
      display: flex;
      gap: 1.6rem;
    }
    .site-nav__list a {
      padding: 0.4rem 0;
      border: 0;
      font-family: var(--f-text);
      font-size: 0.9875rem;
      font-weight: 500;
      color: var(--c-ink);
      border-bottom: 2px solid transparent;
    }
    .site-nav__list a:hover {
      color: var(--c-roast);
      border-bottom-color: var(--c-sand);
    }
    .site-nav__list a[aria-current='page'] {
      color: var(--c-roast);
      border-bottom-color: var(--c-caramel);
    }
    .site-nav__call {
      min-height: 2.6rem;
      padding: 0.5rem 1.1rem;
      font-size: 0.9375rem;
    }
  }
</style>

<style is:global>
  html.nav-open {
    overflow: hidden;
  }
</style>
