---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import heroDefault from '../assets/images/hero-cappuccino.jpg';
import { site } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  title: string;
  subtitle?: string;
  kicker?: string;
  text?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** zeigt „Reservierung anfragen“ + „Speisekarte ansehen“ */
  ctas?: boolean;
  size?: 'large' | 'small';
}

const {
  title,
  subtitle,
  kicker,
  text,
  image = heroDefault,
  imageAlt = 'Cappuccino mit Latte-Art zwischen Grünpflanzen auf einem Holztisch',
  ctas = false,
  size = 'small',
} = Astro.props;
---

<section class:list={['hero', `hero--${size}`]}>
  <Image
    class="hero__img"
    src={image}
    alt={imageAlt}
    widths={[640, 960, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="wrap hero__content">
    {kicker && <p class="hero__kicker">{kicker}</p>}
    <h1>{title}</h1>
    {subtitle && <p class="hero__subtitle">{subtitle}</p>}
    {text && <p class="hero__text">{text}</p>}
    {
      ctas && (
        <div class="btn-row">
          <a class="btn btn--light" href={site.phone.href}>
            <Icon name="phone" />
            Reservierung anfragen
          </a>
          <a class="btn btn--outline-light" href={site.menuPdf} target="_blank" rel="noopener">
            <Icon name="menu-card" />
            Speisekarte ansehen
          </a>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    overflow: hidden;
    background: var(--c-espresso);
    color: var(--c-white);
    isolation: isolate;
  }
  .hero--large {
    min-height: min(46rem, calc(100svh - var(--header-h)));
  }
  .hero--small {
    min-height: clamp(19rem, 48svh, 30rem);
  }
  .hero__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgba(43, 26, 14, 0.92) 0%, rgba(43, 26, 14, 0.6) 45%, rgba(43, 26, 14, 0.25) 100%);
  }
  .hero__content {
    padding-block: var(--space-5) clamp(2.25rem, 1.5rem + 3vw, 4.5rem);
  }
  /* Mobil: Text und Buttons sitzen höher, beide Buttons ohne Scrollen sichtbar */
  @media (max-width: 47.99em) {
    .hero--large {
      min-height: calc(100svh - var(--header-h));
    }
    .hero--large .hero__content {
      padding-bottom: clamp(5rem, 16svh, 9rem);
    }
    .hero--large .btn-row .btn {
      width: 100%;
      max-width: 22rem;
    }
  }
  .hero h1 {
    color: var(--c-white);
    max-width: 18ch;
    margin-bottom: var(--space-2);
  }
  .hero--large h1 {
    font-size: clamp(1.8rem, 0.9rem + 4.6vw, 4.75rem);
    line-height: 1.08;
    letter-spacing: -0.01em;
  }
  .hero__kicker {
    font-family: var(--f-head);
    font-size: var(--fs-lead);
    color: var(--c-oat);
    margin-bottom: var(--space-1);
  }
  .hero__subtitle {
    font-size: var(--fs-lead);
    font-weight: 600;
    color: var(--c-oat);
  }
  .hero__text {
    margin-top: var(--space-2);
    color: rgba(255, 255, 255, 0.9);
    max-width: 60ch;
  }
</style>
