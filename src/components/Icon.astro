---

<svg
  viewBox="0 0 24 24"
  width="24"
  height="24"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
  focusable="false"
  set:html={paths[name]}
/>
