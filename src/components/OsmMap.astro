---
// OpenStreetMap-Karte, lädt erst nach Klick.
import { site } from '../data/site';
import Icon from './Icon.astro';

const { lat, lon } = site.geo;
const d = 0.004;
const bbox = [lon - d * 1.6, lat - d, lon + d * 1.6, lat + d].map((n) => n.toFixed(6)).join('%2C');
const embed = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat}%2C${lon}`;
const link = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lon}#map=17/${lat}/${lon}`;
const address = `${site.address.street}, ${site.address.zip} ${site.address.city}`;
---

<div class="map" data-map-src={embed}>
  <div class="map__placeholder">
    <Icon name="map" />
    <p class="map__address">{address}</p>
    <button type="button" class="btn btn--primary" data-map-load>Karte anzeigen</button>
    <p class="map__note">
      Die Karte wird von OpenStreetMap geladen. <a href={link} target="_blank" rel="noopener">Auf OpenStreetMap öffnen</a>
    </p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-map-src]').forEach((box) => {
    box.querySelector('[data-map-load]')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = box.dataset.mapSrc!;
      iframe.title = 'Karte: Alte Kaffeerösterei, Cappenberger Straße 51, Lünen';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      box.replaceChildren(iframe);
    });
  });
</script>

<style>
  .map {
    width: 100%;
    aspect-ratio: 4 / 3.4;
    border-radius: var(--radius);
    overflow: hidden;
    background:
      repeating-linear-gradient(0deg, transparent 0 38px, rgba(65, 36, 18, 0.07) 38px 39px),
      repeating-linear-gradient(90deg, transparent 0 38px, rgba(65, 36, 18, 0.07) 38px 39px),
      var(--c-oat);
  }
  .map :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
  .map__placeholder {
    height: 100%;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    padding: var(--space-3);
    text-align: center;
  }
  .map__placeholder > :global(svg) {
    width: 2.5rem;
    height: 2.5rem;
    color: var(--c-roast);
  }
  .map__address {
    font-family: var(--f-head);
    color: var(--c-roast);
    font-size: 1.125rem;
  }
  .map__note {
    font-size: 0.8125rem;
    color: var(--c-muted);
    max-width: 30ch;
  }
</style>
