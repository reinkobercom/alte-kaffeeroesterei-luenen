---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  author: string;
  image: ImageMetadata;
}
const { author, image } = Astro.props;
---

<section class="quote">
  <Image class="quote__bg" src={image} alt="" widths={[800, 1400, 1920]} sizes="100vw" />
  <div class="wrap quote__inner">
    <Icon name="quote" />
    <blockquote>
      <slot />
      <footer>{author}</footer>
    </blockquote>
  </div>
</section>

<style>
  .quote {
    position: relative;
    isolation: isolate;
    background: var(--c-cocoa);
    color: var(--c-white);
    padding-block: var(--space-5);
    overflow: hidden;
  }
  .quote__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .quote::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(61, 42, 20, 0.88);
  }
  .quote__inner {
    max-width: calc(52rem + 2 * var(--gutter));
  }
  .quote__inner > svg {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--c-sand);
    margin-bottom: var(--space-2);
  }
  blockquote {
    margin: 0;
    font-family: var(--f-quote);
    font-weight: 300;
    font-size: clamp(1.1875rem, 1rem + 0.9vw, 1.6rem);
    line-height: 1.55;
  }
  blockquote :global(p) {
    max-width: none;
  }
  blockquote footer {
    margin-top: var(--space-3);
    font-family: var(--f-text);
    font-size: 1rem;
    font-style: italic;
    font-weight: 400;
    color: var(--c-oat);
  }
</style>
