---
// Text neben Bild(ern). Mobil untereinander (Text zuerst), ab Tablet nebeneinander.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

type Img = { src: ImageMetadata; alt: string };
interface Props {
  title: string;
  images: Img[];
  /** Bild links statt rechts (ab Tablet) */
  mediaFirst?: boolean;
  background?: 'white' | 'oat';
  id?: string;
}
const { title, images, mediaFirst = false, background = 'white', id } = Astro.props;
const count = images.length;
---

<section
  class:list={['section', 'tm', background === 'oat' && 'section--oat', mediaFirst && 'tm--media-first']}
  id={id}
>
  <div class="wrap tm__grid">
    <div class="tm__text">
      <h2 set:html={title} />
      <slot />
    </div>
    <div class:list={['tm__media', `tm__media--${Math.min(count, 4)}`]}>
      {
        images.map((img) => (
          <Image
            src={img.src}
            alt={img.alt}
            widths={count === 1 ? [640, 960, 1400] : [400, 700, 1000]}
            sizes={count === 1 ? '(min-width: 48em) 50vw, 100vw' : '(min-width: 48em) 25vw, 50vw'}
          />
        ))
      }
    </div>
  </div>
</section>

<style>
  .tm__grid {
    display: grid;
    gap: var(--space-4);
    align-items: center;
  }
  .tm__text :global(.btn-row) {
    margin-top: var(--space-3);
  }
  .tm__media {
    display: grid;
    gap: 0.6rem;
  }
  .tm__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .tm__media--1 img {
    aspect-ratio: 4 / 3;
  }
  .tm__media--2 {
    grid-template-columns: 1fr 1fr;
  }
  .tm__media--2 img {
    aspect-ratio: 3 / 4;
  }
  .tm__media--3,
  .tm__media--4 {
    grid-template-columns: 1fr 1fr;
  }
  .tm__media--3 img,
  .tm__media--4 img {
    aspect-ratio: 1;
  }
  .tm__media--3 img:first-child {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 10;
  }

  @media (min-width: 48em) {
    .tm__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);
    }
    .tm--media-first .tm__media {
      order: -1;
    }
  }
</style>
