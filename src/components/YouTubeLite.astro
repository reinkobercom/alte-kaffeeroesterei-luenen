---
// YouTube erst nach Klick laden (Zwei-Klick-Lösung). Vorher wird keine Verbindung zu YouTube aufgebaut.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';

interface Props {
  id: string;
  title: string;
  poster: ImageMetadata;
  ratio?: '16:9' | '9:16';
}
const { id, title, poster, ratio = '16:9' } = Astro.props;
---

<div class:list={['yt', ratio === '9:16' ? 'yt--portrait' : 'yt--landscape']} data-yt={id} data-yt-title={title}>
  <button type="button" class="yt__btn" aria-label={`Video abspielen: ${title}`}>
    <Image
      src={poster}
      alt=""
      widths={ratio === '9:16' ? [360, 540, 810] : [640, 960, 1280]}
      sizes={ratio === '9:16' ? '(min-width: 48em) 22rem, 80vw' : '(min-width: 48em) 50vw, 100vw'}
    />
    <span class="yt__play" aria-hidden="true"><Icon name="play" /></span>
  </button>
  <p class="yt__note">Beim Abspielen wird das Video von YouTube geladen.</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((box) => {
    const btn = box.querySelector('button');
    btn?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0&playsinline=1`;
      iframe.title = box.dataset.ytTitle || 'YouTube-Video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      btn.replaceWith(iframe);
      box.querySelector('.yt__note')?.remove();
      iframe.focus();
    });
  });
</script>

<style>
  .yt {
    width: 100%;
  }
  .yt--portrait {
    max-width: 22rem;
    margin-inline: auto;
  }
  .yt__btn,
  .yt :global(iframe) {
    position: relative;
    display: block;
    width: 100%;
    border: 0;
    padding: 0;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--c-espresso);
    cursor: pointer;
  }
  .yt--landscape .yt__btn,
  .yt--landscape :global(iframe) {
    aspect-ratio: 16 / 9;
  }
  .yt--portrait .yt__btn,
  .yt--portrait :global(iframe) {
    aspect-ratio: 9 / 16;
  }
  .yt__btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .yt__play {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.92);
    color: var(--c-roast);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
    transition: transform 0.15s ease;
  }
  .yt__play :global(svg) {
    width: 1.75rem;
    height: 1.75rem;
    margin-left: 0.2rem;
  }
  .yt__btn:hover .yt__play {
    transform: translate(-50%, -50%) scale(1.06);
  }
  .yt__note {
    margin-top: 0.5rem;
    font-size: 0.8125rem;
    color: var(--c-muted);
  }
</style>
