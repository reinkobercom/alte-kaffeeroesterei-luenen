---
import Hero from '../components/Hero.astro';
import MenuCta from '../components/MenuCta.astro';
import OpeningHours from '../components/OpeningHours.astro';
import Split from '../components/Split.astro';
import TextMedia from '../components/TextMedia.astro';
import { img } from '../data/images';
import Base from '../layouts/Base.astro';
---

<Base
  title="Frühstück in Lünen"
  description="Ihr perfekter Start in den Tag: In der Alten Kaffeerösterei Lünen genießen Sie in Ruhe ein reichhaltiges Frühstück nach Ihrem Geschmack."
>
  <Hero title="Frühstück" subtitle="Ihr perfekter Start in den Tag" />

  <TextMedia title="Ihr Morgen, Ihr Lieblingsfrühstück." images={img.fruehstueck}>
    <p>
      Sie lieben es, morgens in Ruhe zu frühstücken und gemeinsam mit Ihren Liebsten den Start in den Tag zu genießen?
      Dann sind Sie bei uns genau richtig. Wir bieten Ihnen ein reichhaltiges Frühstück nach Ihrem Geschmack.
    </p>
  </TextMedia>

  <Split title="Aktuelles Frühstücksangebot" background="oat">
    <p class="season">Sommer 2023</p>
    <p>
      Ab dem 01.05.23 bis zum 30.09.23 bieten wir unser Frühstück à la carte an. Wir erweitern hierfür unsere Karte um
      weitere, herzhafte und süße Frühstücksgerichte, sodass für jeden etwas dabei ist.
    </p>
  </Split>

  <MenuCta />

  <OpeningHours />
</Base>

<style>
  .season {
    display: inline-block;
    padding: 0.25rem 0.85rem;
    border-radius: 999px;
    background: var(--c-roast);
    color: var(--c-white);
    font-weight: 600;
    font-size: 0.9375rem;
  }
</style>
